---
# The fork's own rules, beside ansible-lint's: how a change reaches the NAS (AGENTS.md).
# Tested in tests/test_lint_rules.py.
rulesdir:
  - tests/lint_rules/
use_default_rules: true

# Reported, not failed: today's role defaults still hold literal secrets (upstream's
# placeholders). Fix one role at a time; when none is left, drop it from this list.
warn_list:
 - nas-secret-default

skip_list:
 - risky-file-permissions
 - role-name
 - name[missing]
 - key-order[task]
 - name[template]

exclude_paths:
 - tests/lint_rules/fixtures
 - roles/bertvv.samba
 - roles/geerlingguy.docker
 - roles/geerlingguy.docker_arm
 - roles/geerlingguy.nfs
