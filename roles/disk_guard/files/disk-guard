#!/usr/bin/env python3
"""Keep a machine's disks from filling: cap cargo build output, prune old logs, alert early.

Run hourly by a systemd user timer (disk_guard role). Settings come from the environment
(DISK_GUARD_*, written by the role to an EnvironmentFile). It only ever deletes:
  - cargo `target` folders (holding cargo's CACHEDIR.TAG) under DISK_GUARD_ROOTS that nothing
    has written to for DISK_GUARD_ACTIVE_MINUTES, first the stale ones, then the least recently
    used until their total is under the cap;
  - files older than DISK_GUARD_LOG_MAX_AGE_DAYS under DISK_GUARD_LOG_DIRS.
"""

import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

CARGO_SIGNATURE = "Signature: 8a477f597d28d172789f06886806bc55"
DAY = 86400


def env(name, default=""):
    return os.environ.get("DISK_GUARD_" + name, default)


def paths(name):
    return [Path(os.path.expanduser(p)) for p in env(name).split() if p]


def is_cargo_target(folder):
    tag = folder / "CACHEDIR.TAG"
    try:
        return folder.name == "target" and tag.read_text(errors="ignore").startswith(CARGO_SIGNATURE)
    except OSError:
        return False


def find_targets(roots):
    found = []
    for root in roots:
        if not root.is_dir():
            continue
        for dirpath, dirnames, _ in os.walk(root):
            here = Path(dirpath)
            if is_cargo_target(here):
                found.append(here)
                dirnames[:] = []  # never descend into build output
            else:
                dirnames[:] = [d for d in dirnames if d != ".git"]
    return found


def newest_and_size(folder):
    newest, size = folder.stat().st_mtime, 0
    for dirpath, _, filenames in os.walk(folder):
        for name in filenames:
            try:
                st = os.lstat(os.path.join(dirpath, name))
            except OSError:
                continue
            newest = max(newest, st.st_mtime)
            size += st.st_blocks * 512 if hasattr(st, "st_blocks") else st.st_size
    return newest, size


def remove(folder, why, report):
    shutil.rmtree(folder, ignore_errors=True)
    report.append(f"deleted {folder} ({why})")


def prune_targets(report):
    now = time.time()
    active_s = float(env("ACTIVE_MINUTES", "30")) * 60
    max_age_s = float(env("TARGET_MAX_AGE_DAYS", "3")) * DAY
    cap = float(env("TARGET_CAP_MB", "61440")) * 1024 * 1024
    kept = []
    for folder in find_targets(paths("ROOTS")):
        newest, size = newest_and_size(folder)
        if now - newest < active_s:
            kept.append((newest, size, folder, True))
        elif now - newest > max_age_s:
            remove(folder, f"unused {int((now - newest) / DAY)} days", report)
        else:
            kept.append((newest, size, folder, False))
    total = sum(size for _, size, _, _ in kept)
    for newest, size, folder, active in sorted(kept):
        if total <= cap:
            break
        if active:
            continue
        remove(folder, "over the build-output cap", report)
        total -= size
    report.append(f"build output kept: {total / 1024 / 1024:.0f} MB (cap {cap / 1024 / 1024:.0f} MB)")
    if total > cap:
        report.append("build output still over the cap: only folders being built remain")


def prune_logs(report):
    cutoff = time.time() - float(env("LOG_MAX_AGE_DAYS", "30")) * DAY
    count = 0
    for root in paths("LOG_DIRS"):
        if not root.is_dir():
            continue
        for dirpath, _, filenames in os.walk(root):
            for name in filenames:
                p = Path(dirpath) / name
                try:
                    if p.lstat().st_mtime < cutoff:
                        p.unlink()
                        count += 1
                except OSError:
                    pass
    if count:
        report.append(f"deleted {count} old log files")


def use_percent(mount):
    fake = env("FAKE_USE_PERCENT")
    if fake:
        return int(fake)
    out = subprocess.run(["df", "-P", mount], capture_output=True, text=True, check=True).stdout
    return int(out.splitlines()[1].split()[4].rstrip("%"))


def alert(message, report):
    topic = env("NTFY_TOPIC")
    if not topic:
        return
    state = Path(os.path.expanduser(env("STATE", "~/.local/state/disk-guard")))
    state.mkdir(parents=True, exist_ok=True)
    stamp = state / "last-alert"
    every = float(env("ALERT_EVERY_HOURS", "6")) * 3600
    if stamp.exists() and time.time() - stamp.stat().st_mtime < every:
        report.append("alert already sent within the interval")
        return
    fake = env("FAKE_NTFY_FILE")
    try:
        if fake:
            Path(fake).write_text(message)
        else:
            server = env("NTFY_SERVER", "https://ntfy.sh").rstrip("/")
            req = urllib.request.Request(
                f"{server}/{topic}", data=message.encode(),
                headers={"Title": "Disk filling up", "Priority": "high", "Tags": "warning"})
            urllib.request.urlopen(req, timeout=10).read()
        stamp.touch()
        report.append("alert sent")
    except OSError as e:
        report.append(f"alert failed: {e}")


def check_disks(report):
    limit = int(env("ALERT_PERCENT", "80"))
    host = os.environ.get("HOSTNAME") or socket.gethostname()
    full = []
    for mount in env("MOUNTS", "/").split():
        pct = use_percent(mount)
        report.append(f"{mount} {pct}% used")
        if pct >= limit:
            full.append(f"{mount} at {pct}%")
    if full:
        message = f"{host}: {', '.join(full)} (alert at {limit}%). Disk guard pruned what it may."
        report.append("WARNING " + message)
        alert(message, report)


def main():
    report = []
    prune_targets(report)
    prune_logs(report)
    check_disks(report)
    print("disk-guard: " + "; ".join(report))
    return 0


if __name__ == "__main__":
    sys.exit(main())
