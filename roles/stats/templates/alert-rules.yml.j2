apiVersion: 1

groups:
  - orgId: 1
    name: ansible-nas-alerts
    folder: Ansible-NAS
    interval: 1m
    rules:
    - uid: docker-unhealthy
      title: Docker Container Unhealthy
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'count(container_health_status{health_status="unhealthy"}) > 0'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "One or more Docker containers are unhealthy"
      labels:
        severity: warning
      isPaused: false
    - uid: disk-space-low
      title: Disk Space Low
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'disk_used_percent{fstype!~"tmpfs|devtmpfs|devfs|squashfs|nsfs|efivarfs"} > 90'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Disk space is below 10%"
      labels:
        severity: critical
      isPaused: false
    - uid: memory-high
      title: High Memory Usage
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: '(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > 0.9'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Memory usage is above 90%"
      labels:
        severity: warning
      isPaused: false
    - uid: network-down
      title: Network Interface Down
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'node_network_up{device!~"lo|docker.*|veth.*|br-.*"} == 0'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Network interface is down"
      labels:
        severity: critical
      isPaused: false
    - uid: loki-logs-error
      title: Loki Logs Error
      condition: C
      data:
      - refId: A
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum(count_over_time({container=~".+"} |~ "(?i)error|fatal|exception" [5m]))'
          queryType: "range"
          refId: A
      - refId: B
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params: []
                type: gt
              operator:
                type: and
              query:
                params:
                  - B
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: A
          reducer: last
          refId: B
          type: reduce
      - refId: C
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params:
                  - 10
                type: gt
              operator:
                type: and
              query:
                params:
                  - C
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: B
          refId: C
          type: threshold
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "High number of error logs detected"
      labels:
        severity: warning
      isPaused: false
