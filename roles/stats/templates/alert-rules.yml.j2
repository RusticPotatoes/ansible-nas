apiVersion: 1

groups:
  - orgId: 1
    name: ansible-nas-alerts
    folder: Ansible-NAS
    interval: 1m
    rules:
    - uid: docker-container-stopped
      title: Docker Container Stopped
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 600
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'docker_container_status{container_status=~"created|restarting|removing|paused|exited|dead"} == 1'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 10m
      annotations:
        summary: "{% raw %}{{ $labels.container_name }}{% endraw %} has not been running for more than 10 minutes"
        description: "{% raw %}{{ $labels.container_name }}{% endraw %} is in Docker state {% raw %}{{ $labels.container_status }}{% endraw %} on {% raw %}{{ $labels.host }}{% endraw %}."
      labels:
        severity: critical
      isPaused: false
    - uid: docker-unhealthy
      title: Docker Container Unhealthy
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'count(container_health_status{health_status="unhealthy"}) > 0'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "One or more Docker containers are unhealthy"
      labels:
        severity: warning
      isPaused: false
{% if gatus_enabled is defined and gatus_enabled %}
    - uid: gatus-endpoint-down
      title: Gatus Endpoint Down
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 600
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'max_over_time(gatus_results_endpoint_success[{{ stats_gatus_endpoint_alert_window }}]) == 0'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: {{ stats_gatus_endpoint_alert_for }}
      annotations:
        summary: "{% raw %}{{ $labels.group }} / {{ $labels.name }}{% endraw %} is failing synthetic checks"
        description: "Gatus has reported {% raw %}{{ $labels.group }} / {{ $labels.name }}{% endraw %} as down for at least {{ stats_gatus_endpoint_alert_window }}."
      labels:
        severity: critical
      isPaused: false
{% endif %}
    - uid: disk-space-low
      title: Disk Space Low
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'disk_used_percent{fstype!~"tmpfs|devtmpfs|devfs|squashfs|nsfs|efivarfs"} > 90'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Disk space is below 10%"
      labels:
        severity: critical
      isPaused: false
    - uid: memory-high
      title: High Memory Usage
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: '(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > 0.9'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Memory usage is above 90%"
      labels:
        severity: warning
      isPaused: false
    - uid: network-down
      title: Network Interface Down
      condition: A
      data:
      - refId: A
        queryType: "instant"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: ansible_nas
        model:
          expr: 'node_network_up{device!~"lo|docker.*|veth.*|br-.*"} == 0'
          instant: true
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "Network interface is down"
      labels:
        severity: critical
      isPaused: false
    - uid: loki-logs-error
      title: Loki Logs Error
      condition: C
      data:
      - refId: A
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum(count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m]))'
          queryType: "range"
          refId: A
      - refId: B
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params: []
                type: gt
              operator:
                type: and
              query:
                params:
                  - B
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: A
          reducer: last
          refId: B
          type: reduce
      - refId: C
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params:
                  - {{ stats_loki_logs_error_threshold }}
                type: gt
              operator:
                type: and
              query:
                params:
                  - C
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: B
          refId: C
          type: threshold
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "More than {{ stats_loki_logs_error_threshold }} error logs detected in 5 minutes"
      labels:
        severity: warning
      isPaused: false
    - uid: loki-container-logs-error
      title: Loki Container Logs Error
      condition: C
      data:
      - refId: A
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m]))'
          queryType: "range"
          refId: A
      - refId: B
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params: []
                type: gt
              operator:
                type: and
              query:
                params:
                  - B
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: A
          reducer: last
          refId: B
          type: reduce
      - refId: C
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params:
                  - {{ stats_loki_container_logs_error_threshold }}
                type: gt
              operator:
                type: and
              query:
                params:
                  - C
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: B
          refId: C
          type: threshold
      noDataState: "OK"
      execErrState: "Error"
      for: 5m
      annotations:
        summary: "{% raw %}{{ $labels.container }}{% endraw %} logged more than {{ stats_loki_container_logs_error_threshold }} errors in 5 minutes"
      labels:
        severity: warning
      isPaused: false
    - uid: loki-container-error-spike
      title: Loki Container Error Spike
      condition: N
      data:
      - refId: A
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m]))'
          queryType: "range"
          refId: A
      - refId: B
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m] offset 1d))'
          queryType: "range"
          refId: B
      - refId: C
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m] offset 2d))'
          queryType: "range"
          refId: C
      - refId: D
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m] offset 3d))'
          queryType: "range"
          refId: D
      - refId: E
        queryType: "range"
        relativeTimeRange:
          from: 300
          to: 0
        datasourceUid: loki
        model:
          expr: 'sum by (container) (count_over_time({container=~".+"} |~ "(^|[[:space:]])(ERROR|level=error)([[:space:]]|$)" [5m] offset 7d))'
          queryType: "range"
          refId: E
      - refId: F
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: A
          reducer: last
          refId: F
          type: reduce
      - refId: G
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: B
          reducer: last
          refId: G
          type: reduce
      - refId: H
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: C
          reducer: last
          refId: H
          type: reduce
      - refId: I
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: D
          reducer: last
          refId: I
          type: reduce
      - refId: J
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: E
          reducer: last
          refId: J
          type: reduce
      - refId: K
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: ($G + $H + $I + $J) / 4
          refId: K
          type: math
      - refId: L
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: ((($G - $K) ** 2 + ($H - $K) ** 2 + ($I - $K) ** 2 + ($J - $K) ** 2) / 4) ** 0.5
          refId: L
          type: math
      - refId: M
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          datasource:
            type: __expr__
            uid: __expr__
          expression: $F > {{ stats_loki_container_logs_error_anomaly_floor }} && $F > ($K + {{ stats_loki_container_logs_error_anomaly_stddev_multiplier }} * $L)
          refId: M
          type: math
      - refId: N
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params:
                  - 0
                type: gt
              operator:
                type: and
              query:
                params:
                  - N
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: M
          refId: N
          type: threshold
      noDataState: "OK"
      execErrState: "Error"
      for: 10m
      annotations:
        summary: "{% raw %}{{ $labels.container }}{% endraw %} error logs are unusually high"
        description: "{% raw %}{{ $labels.container }}{% endraw %} is over {{ stats_loki_container_logs_error_anomaly_floor }} errors in 5 minutes and above its historical baseline by {{ stats_loki_container_logs_error_anomaly_stddev_multiplier }} standard deviations."
      labels:
        severity: warning
      isPaused: false
