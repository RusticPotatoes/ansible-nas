ui:
  title: Ansible-NAS Synthetic Monitoring
  header: Media Pipeline Health

metrics: true

endpoints:
  - name: Sonarr API
    group: Media Pipeline - Service Health
    url: "http://{{ ansible_nas_ip }}:8989/api/v3/system/status"
    headers:
      X-Api-Key: "{{ sonarr_api_key }}"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].version != ''"

  - name: Prowlarr API
    group: Media Pipeline - Service Health
    url: "http://{{ ansible_nas_ip }}:9696/api/v1/system/status"
    headers:
      X-Api-Key: "{{ prowlarr_api_key }}"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].version != ''"

  - name: NZBGet API
    group: Media Pipeline - Service Health
    url: "http://{{ ansible_nas_ip }}:6789/jsonrpc/status"
    headers:
      Authorization: "Basic {{ (nzbget_user ~ ':' ~ nzbget_pass) | b64encode }}"
    interval: 1m
    conditions:
      - "[STATUS] == 200"

  - name: Deluge Web UI
    group: Media Pipeline - Service Health
    url: "http://{{ ansible_nas_ip }}:8112"
    interval: 1m
    conditions:
      - "[STATUS] == 200"

  - name: Sonarr Health Checks
    group: Media Pipeline - App Health
    url: "http://{{ ansible_nas_ip }}:8989/api/v3/health"
    headers:
      X-Api-Key: "{{ sonarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Prowlarr Health Checks
    group: Media Pipeline - App Health
    url: "http://{{ ansible_nas_ip }}:9696/api/v1/health"
    headers:
      X-Api-Key: "{{ prowlarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Sonarr Download Clients Configured
    group: Media Pipeline - Handoffs
    url: "http://{{ ansible_nas_ip }}:8989/api/v3/downloadclient"
    headers:
      X-Api-Key: "{{ sonarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Prowlarr Applications Configured
    group: Media Pipeline - Handoffs
    url: "http://{{ ansible_nas_ip }}:9696/api/v1/applications"
    headers:
      X-Api-Key: "{{ prowlarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Prowlarr Indexers Configured
    group: Media Pipeline - Handoffs
    url: "http://{{ ansible_nas_ip }}:9696/api/v1/indexer"
    headers:
      X-Api-Key: "{{ prowlarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Sonarr Queue Not Growing
    group: Media Pipeline - Queues
    url: "http://{{ ansible_nas_ip }}:8989/api/v3/queue?page=1&pageSize=100"
    headers:
      X-Api-Key: "{{ sonarr_api_key }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].totalRecords < 20"

  - name: NZBGet Queue Reachable
    group: Media Pipeline - Queues
    url: "http://{{ ansible_nas_ip }}:6789/jsonrpc/listgroups"
    headers:
      Authorization: "Basic {{ (nzbget_user ~ ':' ~ nzbget_pass) | b64encode }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: NZBGet History Reachable
    group: Media Pipeline - Queues
    url: "http://{{ ansible_nas_ip }}:6789/jsonrpc/history"
    headers:
      Authorization: "Basic {{ (nzbget_user ~ ':' ~ nzbget_pass) | b64encode }}"
    interval: 10m
    conditions:
      - "[STATUS] == 200"

  - name: Sonarr Web UI
    group: Media Pipeline - Web UIs
    url: "http://{{ ansible_nas_ip }}:8989"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: Prowlarr Web UI
    group: Media Pipeline - Web UIs
    url: "http://{{ ansible_nas_ip }}:9696"
    interval: 5m
    conditions:
      - "[STATUS] == 200"

  - name: NZBGet Web UI
    group: Media Pipeline - Web UIs
    url: "http://{{ ansible_nas_ip }}:6789"
    headers:
      Authorization: "Basic {{ (nzbget_user ~ ':' ~ nzbget_pass) | b64encode }}"
    interval: 5m
    conditions:
      - "[STATUS] == 200"