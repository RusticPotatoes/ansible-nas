#!/bin/bash
# Managed by Ansible (nas_maintenance). Nightly logical dumps of container
# databases into {{ nas_db_dump_directory }} so file-level backups get a
# consistent copy. Credentials are read from each container's own environment.
set -uo pipefail

out="{{ nas_db_dump_directory }}"
status="{{ nas_status_directory }}"
rc=0

# dump NAME CONTAINER FILE FILTER COMMAND...: write atomically, record success for Telegraf.
# FILTER reads the dump on stdin, on this host. The pipeline runs in this script's shell, where
# pipefail is set, so a failed `docker exec` (a failed pg_dumpall) fails the dump, whatever
# shell or options the container has.
dump() {
  local name=$1 container=$2 file=$3 filter=$4; shift 4
  if ! docker inspect -f '{{ '{{' }}.State.Running{{ '}}' }}' "$container" 2>/dev/null | grep -q true; then
    echo "$name: container $container not running" >&2; rc=1; return
  fi
  if docker exec "$container" sh -c "$*" | $filter > "$out/$file.tmp"; then
    mv "$out/$file.tmp" "$out/$file"
    echo "nas_db_dump,db=$name last_success=$(date +%s)i" > "$status/db_$name.influx"
    echo "$name: ok ($(du -h "$out/$file" | cut -f1))"
  else
    rm -f "$out/$file.tmp"; echo "$name: dump failed" >&2; rc=1
  fi
}

{% if nas_db_dump_postgres_container %}
dump postgres {{ nas_db_dump_postgres_container }} postgres.sql.gz gzip \
  'pg_dumpall -U "$POSTGRES_USER"'
{% endif %}
{% if nas_db_dump_mongodb_container %}
dump mongodb {{ nas_db_dump_mongodb_container }} mongodb.archive.gz cat \
  'mongodump --quiet --archive --gzip --authenticationDatabase admin -u "$MONGODB_INITDB_ROOT_USERNAME" -p "$MONGODB_INITDB_ROOT_PASSWORD"'
{% endif %}

exit $rc
